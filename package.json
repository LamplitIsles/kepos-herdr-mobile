{
  "name": "kepos-herdr-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "bun run build && cap sync android",
    "android:apk": "bun run android:sync && cd android && ./gradlew assembleDebug",
    "android:install": "bun run android:apk && adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "svelte": "^5.38.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.3.0",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
